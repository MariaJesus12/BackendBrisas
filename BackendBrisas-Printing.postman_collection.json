{
  "info": {
    "name": "BackendBrisas Printing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion para autenticacion, impresion, cocina y facturacion de BackendBrisas"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": "15"
    },
    {
      "key": "jobId",
      "value": "1"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "123456"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Pedidos Impresion",
      "item": [
        {
          "name": "Enviar a cocina",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"copias\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/enviar-cocina",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "{{pedidoId}}", "enviar-cocina"]
            }
          }
        },
        {
          "name": "Facturar pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"copias\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/facturar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "{{pedidoId}}", "facturar"]
            }
          }
        },
        {
          "name": "Reimprimir cocina",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"copias\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/reimprimir-cocina",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "{{pedidoId}}", "reimprimir-cocina"]
            }
          }
        },
        {
          "name": "Reimprimir factura",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"copias\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/reimprimir-factura",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "{{pedidoId}}", "reimprimir-factura"]
            }
          }
        },
        {
          "name": "Ver pedido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "{{pedidoId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Impresion",
      "item": [
        {
          "name": "Listar impresoras",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/impresion/impresoras?active=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "impresion", "impresoras"],
              "query": [
                {
                  "key": "active",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Listar cola",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/impresion/cola?estado=PENDIENTE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "impresion", "cola"],
              "query": [
                {
                  "key": "estado",
                  "value": "PENDIENTE"
                }
              ]
            }
          }
        },
        {
          "name": "Tomar siguiente trabajo cocina",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"COCINA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/impresion/cola/next",
              "host": ["{{baseUrl}}"],
              "path": ["api", "impresion", "cola", "next"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.job && data.job.id) { pm.collectionVariables.set('jobId', data.job.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Tomar siguiente trabajo factura",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"FACTURA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/impresion/cola/next",
              "host": ["{{baseUrl}}"],
              "path": ["api", "impresion", "cola", "next"]
            }
          }
        },
        {
          "name": "Ver trabajo de impresion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/impresion/cola/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "impresion", "cola", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Marcar trabajo impreso",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"IMPRESO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/impresion/cola/{{jobId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "impresion", "cola", "{{jobId}}", "status"]
            }
          }
        },
        {
          "name": "Marcar trabajo con error",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ERROR\",\n  \"mensajeError\": \"No se pudo imprimir\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/impresion/cola/{{jobId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "impresion", "cola", "{{jobId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
