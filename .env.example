# Entorno local
NODE_ENV="development"

# Conexion MySQL para pruebas locales con external host
# Formato: mysql://USUARIO:CLAVE@HOST:PUERTO/DB
DATABASE_URL="mysql://root:password@external-host:3306/Brisasdellago"

# Puerto del backend
PORT=3000

# Origen permitido para CORS (separa multiples por coma)
CORS_ORIGIN="http://localhost:5173"

# Secreto para firmar tokens JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo"

# Duracion criptografica del token
JWT_EXPIRES_IN="12h"

# Cierre de sesion por inactividad en horas
SESSION_INACTIVITY_HOURS=5

# Costo de bcrypt para hash de passwords al crear usuarios
BCRYPT_SALT_ROUNDS=10
